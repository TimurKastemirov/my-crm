NODE_ENV=local
PORT=3000

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=crm_db
POSTGRES_USER=admin
POSTGRES_PASSWORD=123456

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_TLS_ENABLED=false
REDIS_PASSWORD=

# JWT: станут обязательными с модулем Auth (§6). Сгенерируйте длинные случайные строки,
# напр.: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# CORS: список origin через запятую, либо * в dev
CORS_ORIGINS=*
