{
  "name": "@crm/shared",
  "version": "0.0.1",
  "description": "Общий контракт API (типы, enum'ы, коды прав, пагинация) для backend и frontend",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
